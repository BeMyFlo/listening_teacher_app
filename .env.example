# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/listening_app?retryWrites=true&w=majority

# Any long random string — used to sign teacher login sessions
JWT_SECRET=change-this-to-a-long-random-string

# Password the teacher types on the "Giáo viên" login screen
# NOTE: only used ONCE to bootstrap the first teacher account via /api/auth
# (any username + this password creates the first Teacher in the DB).
# After a Teacher exists this variable has no effect — safe to remove or keep.
TEACHER_PASSWORD=2026

# Cloudinary (Dashboard → Account Details) — used to store uploaded audio files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini — used for AI-assisted grading of Writing/Speaking submissions.
# Leave empty to disable AI grading (teachers grade manually only).
GEMINI_API_KEY=
# Optional — defaults to "gemini-2.5-flash-lite" when empty.
GEMINI_MODEL=

# Gmail SMTP — used to email students (deadline reminders, etc). Leave empty
# to disable email sending (in-app notifications still work).
#   GMAIL_USER: the Gmail address used to send, e.g. msnhi.center@gmail.com
#   GMAIL_APP_PASSWORD: 16-char App Password (Google Account → Security →
#     2-Step Verification → App passwords), no spaces
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional — display name for the From header, e.g. "Ms Nhi IELTS <msnhi.center@gmail.com>"
EMAIL_FROM=

# Public URL of this app — used to build links inside notification emails
APP_URL=

# Secret Vercel Cron sends as "Authorization: Bearer <value>" when calling
# /api/cron/deadline-scan. Required in production; optional in dev.
CRON_SECRET=
