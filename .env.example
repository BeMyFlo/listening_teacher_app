# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/listening_app?retryWrites=true&w=majority

# Any long random string — used to sign teacher login sessions
JWT_SECRET=change-this-to-a-long-random-string

# Password the teacher types on the "Giáo viên" login screen
# NOTE: only used ONCE to bootstrap the first teacher account via /api/auth
# (any username + this password creates the first Teacher in the DB).
# After a Teacher exists this variable has no effect — safe to remove or keep.
TEACHER_PASSWORD=2026

# Cloudinary (Dashboard → Account Details) — used to store uploaded audio files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
